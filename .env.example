# Semua variabel di bawah ini HANYA untuk server (API function).
# Jangan pakai prefix VITE_ — kalau prefix VITE_, nilainya ikut ter-bundle
# ke browser dan kredensial database akan bocor.

# Postgres Neon (branch main). Di Vercel, cukup set DATABASE_URL (pooler).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Object Storage (S3-compatible).
# Didapat dari: neon env pull
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-6.us-east-2.aws.neon.tech
AWS_REGION=us-east-2

# Password gerbang menu Pengaturan (Line Name & Departemen).
# Catatan: dibandingkan di client (inlined di bundle), bukan gerbang keamanan.
VITE_ADMIN_PASSWORD=your_admin_password
